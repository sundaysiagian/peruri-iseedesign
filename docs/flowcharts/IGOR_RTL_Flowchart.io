<mxfile host="app.diagrams.net" version="24.7.17" type="device" compressed="false"><diagram id="page1" name="00 - Panduan dan legenda"><mxGraphModel dx="2100" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="00 - Panduan dan legenda" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=28;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="25" width="2020" height="55" /></mxCell><mxCell id="n2" value="IGOR | DE10-Nano 5CSEBA6U23I7 | Sumber: 19 file rtl/*.v final | Hitam-putih" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="2020" height="70" /></mxCell><mxCell id="n3" value="SATU FILE / BANYAK HALAMAN&#10;00 panduan; 01 Level 0; 02 Level 1 board; 03 hierarchy; 04 bit packing;&#10;05-23 seluruh modul &amp; port; 24-27 flowchart control / tile / neural / UART.&#10;TOP BOARD = igor_uart_top, bukan igor_top.&#10;XML mxfile untuk diagrams.net/draw.io; buka melalui File &gt; Open From &gt; Device.&#10;Jika pemilih ekstensi menyaring .io, gunakan All files atau impor isi XML." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;rounded=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="190" width="1960" height="210" /></mxCell><mxCell id="n4" value="INPUT / OUTPUT&#10;Nama sinyal + range + width" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=19;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="470" width="350" height="160" /></mxCell><mxCell id="n5" value="MODUL VERILOG&#10;subroutine / modul hierarkis" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=19;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=process;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="470" width="350" height="160" /></mxCell><mxCell id="n6" value="MEMORI / ROM&#10;depth x width" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=19;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=cylinder;" vertex="1" parent="1"><mxGeometry as="geometry" x="870" y="470" width="350" height="160" /></mxCell><mxCell id="n7" value="KEPUTUSAN&#10;Ya / Tidak" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=19;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="1270" y="470" width="350" height="160" /></mxCell><mxCell id="n8" value="AWAL / AKHIR&#10;atau konektor state" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=19;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry as="geometry" x="1670" y="470" width="350" height="160" /></mxCell><mxCell id="n9" value="KONVENSI BIT&#10;[n:0] = n+1 bit; s = signed; u = unsigned. Scalar = 1 bit.&#10;Jumlah bit I/O adalah penjumlahan lebar port RTL, termasuk clock/reset; bukan throughput.&#10;Bus gabungan ditulis N x W = total bit. Net tags menyambungkan sinyal dengan nama sama tanpa garis silang.&#10;Garis panah = arah data/control; clock/reset dibagikan, bukan data payload.&#10;ROM neural: 8192 x 16; 6020 word aktif. NN tidak mengubah ranking DWA pada rilis ini." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;rounded=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="720" width="1960" height="260" /></mxCell><mxCell id="n10" value="LINGKUP&#10;Semua 19 modul aktif/alternatif ditampilkan. Testbench tb/*.v bukan hardware yang disintesis.&#10;igor_de10_nano_wrapper = demo alternatif, tidak dipilih sebagai top SOF.&#10;RTL / pin / SOF tidak diubah oleh pembuatan diagram ini." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;rounded=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="1070" width="1960" height="200" /></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="01 - Level 0 / batas sistem"><mxGraphModel dx="2100" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="01 - Level 0 / batas sistem" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=28;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="25" width="2020" height="55" /></mxCell><mxCell id="n2" value="TOP BOARD: igor_uart_top | 4 input ports / 8 input bits | 2 output ports / 9 output bits" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="2020" height="70" /></mxCell><mxCell id="n3" value="INPUT BOARD&#10;FPGA_CLK1_50 [0:0] = 1 b&#10;KEY[1:0] = 2 b&#10;SW[3:0] = 4 b&#10;UART_RX [0:0] = 1 b&#10;TOTAL = 8 b" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="240" width="470" height="340" /></mxCell><mxCell id="n4" value="igor_uart_top&#10;DE10-Nano / 5CSEBA6U23I7&#10;50 MHz&#10;UART + DWA 512 kandidat&#10;NN 24 -&gt; 64 -&gt; 64 -&gt; 4&#10;Reset sync + response mux" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=26;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=process;" vertex="1" parent="1"><mxGeometry as="geometry" x="780" y="240" width="570" height="340" /></mxCell><mxCell id="n5" value="OUTPUT BOARD&#10;UART_TX [0:0] = 1 b&#10;LED[7:0] = 8 b&#10;TOTAL = 9 b&#10;Tidak ada pin motor/HPS" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1"><mxGeometry as="geometry" x="1600" y="240" width="450" height="340" /></mxCell><mxCell id="e6" value="8 b port input" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;fontColor=#000000;fontSize=17;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n3" target="n4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="9 b port output" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;fontColor=#000000;fontSize=17;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n4" target="n5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n8" value="UART fisik: RX/TX masing-masing 1 bit serial, 115200 baud 8N1.&#10;Request: 8 byte = 64 bit framing, bukan bus paralel 64-bit di pin.&#10;A5[8] | opcode[8] | payload[32 LE] | CRC8[8] | 5A[8]&#10;Response: 5A[8] | opcode[8] | response[32 LE] | CRC8[8] | A5[8]" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;rounded=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="740" width="1900" height="240" /></mxCell><mxCell id="n9" value="PIN: clock V11 | RX V12 = JP1 pin1 | TX E8 = JP1 pin2 | GND JP1 pin12 / pin30&#10;KEY0 reset active-low; KEY1 inhibit active-low; SW2 not-ready; SW3 protective; SW0/1 unused." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="1030" width="1900" height="140" /></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="02 - Level 1 / integrasi board"><mxGraphModel dx="2100" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="02 - Level 1 / integrasi board" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=28;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="25" width="2220" height="55" /></mxCell><mxCell id="n2" value="Net tags bernama sama menyatakan koneksi. Panah kiri ke kanan tidak bersilangan. clk/rst_n = 1 b masing-masing." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="2220" height="70" /></mxCell><mxCell id="n3" value="UART_RX 1b + response 32b&#10;clk 1b + rst_n 1b" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="200" width="670" height="280" /></mxCell><mxCell id="n4" value="serial : igor_uart_protocol&#10;&#10;RX/TX child modules&#10;CRC8 + response_sample[31:0]" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=process;" vertex="1" parent="1"><mxGeometry as="geometry" x="880" y="200" width="570" height="280" /></mxCell><mxCell id="n5" value="UART_TX 1b&#10;command_valid 1b -&gt; command&#10;opcode 8b -&gt; op; payload 32b -&gt; data&#10;protocol_fault 1b" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1"><mxGeometry as="geometry" x="1620" y="200" width="640" height="280" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;fontColor=#000000;fontSize=17;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n3" target="n4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;fontColor=#000000;fontSize=17;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n4" target="n5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n8" value="command 1b + op 8b -&gt; decode&#10;data 32b -&gt; cfg_data/map_sequence&#10;data[14:0] -&gt; map_address 15b&#10;data[23:16] -&gt; map_byte 8b&#10;ready/estop/protective + strobes 1b each" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="565" width="670" height="280" /></mxCell><mxCell id="n9" value="core : igor_top&#10;&#10;4 tiles + replicated costmaps&#10;config / selector / gate / logger" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=process;" vertex="1" parent="1"><mxGeometry as="geometry" x="880" y="565" width="570" height="280" /></mxCell><mxCell id="n10" value="enable/busy/done 1b each&#10;vc 5b; wc signed 7b; fault 8b&#10;index 9b; latency 32b&#10;score/cost/goal/velocity/events 32b each&#10;last 8b" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1"><mxGeometry as="geometry" x="1620" y="565" width="640" height="280" /></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;fontColor=#000000;fontSize=17;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n8" target="n9"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;fontColor=#000000;fontSize=17;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n9" target="n10"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n13" value="load_input = command &amp; op10 [1b]&#10;start = command &amp; op11 [1b]&#10;input_index = data[4:0] [5b]&#10;input_value = data[23:8] [s16b]&#10;output_index = data[1:0] [2b]" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="930" width="670" height="280" /></mxCell><mxCell id="n14" value="neural : igor_neural_core&#10;&#10;24 x16 -&gt; 64 x16 -&gt; 64 x16 -&gt; 4 x16&#10;serial MAC 16x16 -&gt; 32; accumulator40" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=process;" vertex="1" parent="1"><mxGeometry as="geometry" x="880" y="930" width="570" height="280" /></mxCell><mxCell id="n15" value="nn_value signed16b&#10;nn_busy / nn_done / nn_fault 1b each&#10;nn_cycles 32b&#10;-&gt; response mux op12 / op13" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1"><mxGeometry as="geometry" x="1620" y="930" width="640" height="280" /></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;fontColor=#000000;fontSize=17;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n13" target="n14"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;fontColor=#000000;fontSize=17;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n14" target="n15"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n18" value="address = data[12:0] [13b]&#10;clk 1b&#10;op8 requires full data &lt; 6020" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1295" width="670" height="280" /></mxCell><mxCell id="n19" value="inspection_rom : igor_neural_rom&#10;&#10;8192 x16-bit ROM&#10;6020 active words + zero padding" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=process;" vertex="1" parent="1"><mxGeometry as="geometry" x="880" y="1295" width="570" height="280" /></mxCell><mxCell id="n20" value="rom_data signed16b&#10;-&gt; response mux op8&#10;zero extension -&gt; response 32b" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1"><mxGeometry as="geometry" x="1620" y="1295" width="640" height="280" /></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;fontColor=#000000;fontSize=17;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n18" target="n19"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;fontColor=#000000;fontSize=17;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n19" target="n20"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n23" value="INLINE LOGIC (igor_uart_top): opcode decode; invalid_command sticky[1]; KEY0 reset_sync[1:0]; SW two-stage sync[3:0].&#10;RESPONSE MUX: op8 ROM16-&gt;32; op9 latency32; op12 NN flags3+value16+zero13; op13 NN cycles32; op14 zero20+wc7+vc5; default status32.&#10;LED[7:0]={fault[3:0],done,busy,rst_n,enable}. UART response_data[31:0] feeds serial (top row)." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;rounded=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1680" width="2220" height="175" /></mxCell></root></mxGraphModel></diagram><diagram id="page4" name="03 - RTL module breakdown / instances"><mxGraphModel dx="2100" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1850" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="03 - RTL module breakdown / instances" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=28;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="25" width="2220" height="55" /></mxCell><mxCell id="n2" value="Semua modul di folder rtl/ ditampilkan | Active hierarchy vs alternative demo | instance name : module name" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="2220" height="70" /></mxCell><mxCell id="n3" value="ACTIVE TOP: igor_uart_top&#10;reset/SW synchronization; opcode decode; response mux" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=process;" vertex="1" parent="1"><mxGeometry as="geometry" x="730" y="185" width="840" height="100" /></mxCell><mxCell id="n4" value="serial : igor_uart_protocol&#10;receiver : igor_uart_rx&#10;transmitter : igor_uart_tx&#10;&#10;UART decode / encode&#10;byte 8b &lt;-&gt; payload32b" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=process;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="390" width="510" height="235" /></mxCell><mxCell id="n5" value="core : igor_top&#10;see core expansion below&#10;&#10;DWA control&#10;15 input ports / 98b&#10;14 output ports / 232b" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=process;" vertex="1" parent="1"><mxGeometry as="geometry" x="610" y="390" width="510" height="235" /></mxCell><mxCell id="n6" value="neural : igor_neural_core&#10;weights : igor_neural_rom&#10;&#10;NN sequential MAC&#10;ROM address13 -&gt; sdata16" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=process;" vertex="1" parent="1"><mxGeometry as="geometry" x="1180" y="390" width="510" height="235" /></mxCell><mxCell id="n7" value="inspection_rom : igor_neural_rom&#10;&#10;Direct UART ROM readback&#10;address13 -&gt; sdata16" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=process;" vertex="1" parent="1"><mxGeometry as="geometry" x="1750" y="390" width="510" height="235" /></mxCell><mxCell id="n8" value="CORE EXPANSION: igor_top&#10;cfg : igor_config_registers | maps : igor_costmap_manager&#10;selector : igor_best_candidate_selector | gate : igor_safety_security_gate | logger : igor_status_logger&#10;generate tiles[0], tiles[1], tiles[2], tiles[3] (all four instances instantiated)" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=process;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="730" width="2140" height="185" /></mxCell><mxCell id="n9" value="EACH tiles[t] (t=0..3)&#10;memory : igor_costmap_bank = 32768 x8 bits, two banks&#10;tile : igor_rollout_tile, TILE_ID=t, HORIZON=20&#10;map read = {bank[1], address[14]} -&gt; data[8]&#10;per tile: best_index[9], best_valid/done/fault[1 each], scores/costs/goals/velocities[32 each]" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=process;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1020" width="1000" height="265" /></mxCell><mxCell id="n10" value="EACH rollout tile children&#10;gen : igor_candidate_generator -&gt; velocity[4], omega[s6], window_legal[1]&#10;stepper : igor_kinematic_step -&gt; next_x/next_y[s24], next_heading[8], flags[1]&#10;  s + c : igor_trig_lut (2 instances) -&gt; sn/cs[s16]&#10;acc : igor_score_accumulator -&gt; sum[32], overflow[1]" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=process;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="1020" width="1000" height="265" /></mxCell><mxCell id="n11" value="FOUR-TILE AGGREGATION&#10;valid/done/fault: each 4 x1 = 4b&#10;indices: 4 x9 = 36b&#10;scores, costs, goals, velocities: each 4 x32 = 128b&#10;selector -&gt; best_index9 + valid1 + 4 metrics x32&#10;gate -&gt; enable1 + v5 + omega7 + fault_code8" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;rounded=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1390" width="1000" height="330" /></mxCell><mxCell id="n12" value="ALTERNATIVE, NOT ACTIVE SOF TOP&#10;igor_de10_nano_wrapper&#10;core : igor_top (same descendants)&#10;Demo FSM generates config, synthetic map, start.&#10;FPGA_CLK1_50[1] + KEY[2] + SW[4] -&gt; LED[8]&#10;Retained for simulation, not selected in igor.qsf." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=process;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="1390" width="1000" height="330" /></mxCell></root></mxGraphModel></diagram><diagram id="page5" name="04 - Bit flow / packing / memory"><mxGraphModel dx="2100" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1720" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="04 - Bit flow / packing / memory" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=28;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="25" width="2220" height="55" /></mxCell><mxCell id="n2" value="Bit ranges are exact RTL ranges. Network architecture counts neurons, not parallel FPGA pin width." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="2220" height="70" /></mxCell><mxCell id="n3" value="UART packet / response status&#10;&#10;Request64 = A5[8] + op[8] + data[32 LE] + CRC[8] + 5A[8]&#10;Response64 = 5A[8] + op[8] + response[32 LE] + CRC[8] + A5[8]&#10;status32: [31:25]zero7; [24:16]index9; [15:8]fault8;&#10;[7:5]zero3; [4]invalid; [3]protocol_fault; [2]done; [1]busy; [0]enable" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;rounded=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="200" width="1060" height="620" /></mxCell><mxCell id="n4" value="Neural datapath / ROM layout&#10;&#10;input_value s16 Q8.8; input_index5 (0..23); output_index2 (0..3)&#10;24x16 input, 64x16 h1, 64x16 h2, 4x16 output&#10;operand16 x weight16 -&gt; product32; sign extend -&gt; accumulator40&#10;accumulator[39:8] = signed32 floor; hidden ReLU/clamp; output clip +/-256&#10;ROM8192 x16; W1@0 / b1@1536 / W2@1600 / b2@5696 / W3@5760 / b3@6016" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=cylinder;" vertex="1" parent="1"><mxGeometry as="geometry" x="1190" y="200" width="1060" height="620" /></mxCell><mxCell id="n5" value="DWA candidate / pose / score&#10;&#10;candidate_index9 = {v_index4, omega_index5}; omega = omega_index - 16&#10;velocity4 -&gt; gate candidate_v5 (zero extended); omega6 -&gt; candidate_w7 signed&#10;x,y s24 (8 fractional bits); heading8; pose6; 20 steps&#10;map_addr14={y[14:8],x[14:8]}; bank1+map_addr14=physical read15&#10;cost_sum32; weighted33; final_score33; goal32; velocity_penalty32" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;rounded=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="910" width="1060" height="620" /></mxCell><mxCell id="n6" value="Costmap &amp; safety / bandwidth&#10;&#10;4 replicated igor_costmap_bank, each32768 x8 =262144 bits&#10;Total map storage4 x262144 =1048576 bits; write broadcast to four replicas&#10;Logical active map128 x128 x8; two banks per replica&#10;Frame sequence32; age32; full load16384 ascending bytes before atomic commit&#10;UART is stop-and-wait; 20ms map age/command lease starts at commit/start&#10;Neural readout has NO connection to DWA ranking or motor on this release" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;rounded=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1190" y="910" width="1060" height="620" /></mxCell></root></mxGraphModel></diagram><diagram id="page6" name="05 - igor_best_candidate_selector"><mxGraphModel dx="2100" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="05 - igor_best_candidate_selector" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=28;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="25" width="2220" height="55" /></mxCell><mxCell id="n2" value="rtl/igor_best_candidate_selector.v | INPUT: 6 ports / 552 bits | OUTPUT: 6 ports / 138 bits | all scalar ports explicitly 1b" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="2220" height="70" /></mxCell><mxCell id="n3" value="igor_best_candidate_selector&#10;&#10;Balanced two-level tournament across 4 tiles.&#10;valid4; indices4x9=36.&#10;scores/costs/goals/velocities each4x32=128.&#10;Minimum score wins; tie -&gt; smallest index.&#10;No valid input -&gt; zero metrics + best_valid=0." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=process;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="200" width="640" height="720" /></mxCell><mxCell id="n4" value="valid[3:0]&#10;4 bit unsigned" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="210" width="550" height="70" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;fontColor=#000000;fontSize=17;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.0625;" edge="1" parent="1" source="n4" target="n3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n6" value="indices[35:0]&#10;36 bit unsigned" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;shape=parallelogram;perimeter=parallelogramPerim